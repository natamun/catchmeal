VITE_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kcalapp
DATABASE_URL=postgresql://changeme:changeme@postgres:5432/kcalapp
DOMAIN=localhost

# Dev containers run as this UID/GID so files written via bind mounts
# (dist/, prisma generate output) belong to you, not root.
# Run `id -u` and `id -g` if your values differ from the default.
UID=1000
GID=1000
