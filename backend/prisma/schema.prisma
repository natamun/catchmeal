// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  name              String
  email             String        @unique
  passwordHash      String
  role              String        @default("User")
  createAt          DateTime      @default(now())
  meal              Meal[]
  friendOf          Friend[]      @relation("FriendOf")
  userFriend        Friend[]      @relation("UserFriends")
  senderMessage     Message[]     @relation("SenderMessage")
  receiverMessage   Message[]     @relation("ReceivedMessage")
  weightLogs        WeightLog[]
  goalSettings      GoalSetting[]
}

model Friend {
  id                Int     @id @default(autoincrement())
  userId            Int
  friendId          Int
  note              String?
  lastTimeConnected Int
  user              User    @relation("UserFriends", fields: [userId], references: [id])
  friendUser        User    @relation("FriendOf", fields: [friendId], references: [id])
}

model Message {
  id          Int       @id @default(autoincrement())
  receiverId  Int
  senderId    Int
  content     String
  sentAt      DateTime  @default(now())
  sender      User      @relation("SenderMessage", fields: [senderId], references: [id])
  receiver    User      @relation("ReceivedMessage", fields: [receiverId], references: [id])
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  weight    Float
  bodyFat   Float?
  loggedAt  DateTime @default(now())
  note      String?
  @@index([userId, loggedAt])
}

model Meal {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  typeMeal  String
  loggedAt  DateTime  @default(now())
  items MealItem[]
}

model MealItem {
  id       Int    @id @default(autoincrement())
  mealId   Int
  meal     Meal   @relation(fields: [mealId], references: [id])
  name     String
  quantity Float
  kcal     Float
  protein  Float
  carbs    Float
  fat      Float
}

model GoalSetting {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  dailyCalories Int
  objective     String?
  startDate     DateTime @default(now())
}