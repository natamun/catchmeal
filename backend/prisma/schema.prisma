// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

model User {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  name              String
  email             String        @unique
  passwordHash      String
  avatarUrl         String?
  height            Float?
  targetWeight      Float?
  dailyCalorieGoal  Int?
  dailyProteinGoal  Int?
  gender            Gender?
  birthDate         DateTime?
  activityLevel     ActivityLevel?
  role              Role          @default(USER)
  createAt          DateTime      @default(now())
  meal              Meal[]
  foodItems         FoodItem[]
  mealFoodItems     MealFoodItem[]
  friendOf          Friend[]      @relation("FriendOf")
  userFriend        Friend[]      @relation("UserFriends")
  senderMessage     Message[]     @relation("SenderMessage")
  receiverMessage   Message[]     @relation("ReceivedMessage")
  weightLogs        WeightLog[]
  goalSettings      GoalSetting[]
}

model Friend {
  id                Int     @id @default(autoincrement())
  userId            Int
  friendId          Int
  note              String? @db.VarChar(255)
  lastTimeConnected DateTime
  user              User    @relation("UserFriends", fields: [userId], references: [id])
  friendUser        User    @relation("FriendOf", fields: [friendId], references: [id])
  @@index([userId])
  @@index([friendId])
}

model Message {
  id          Int       @id @default(autoincrement())
  receiverId  Int
  senderId    Int
  content     String
  sentAt      DateTime  @default(now())
  sender      User      @relation("SenderMessage", fields: [senderId], references: [id])
  receiver    User      @relation("ReceivedMessage", fields: [receiverId], references: [id])
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  weight    Float
  bodyFat   Float?
  loggedAt  DateTime @default(now())
  note      String?  @db.VarChar(255)
  @@index([userId, loggedAt])
}

enum QuantityUnit {
  GRAM
  PIECE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model FoodItem {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  name          String
  brand         String?
  barcode       String?
  baseQuantity  Float
  baseUnit      QuantityUnit
  kcal          Float
  protein       Float
  carbs         Float
  fat           Float
  archived      Boolean        @default(false)
  mealFoodItems MealFoodItem[]

  @@unique([id, userId])
  @@index([userId])
}

model Meal {
  id           Int            @id @default(autoincrement())
  userId       Int
  user         User           @relation(fields: [userId], references: [id])
  name         String?
  typeMeal     MealType?
  loggedAt     DateTime?      @db.Date
  sourceMealId Int?
  sourceMeal   Meal?          @relation("MealTemplate", fields: [sourceMealId], references: [id], onDelete: SetNull)
  instances    Meal[]         @relation("MealTemplate")
  items        MealFoodItem[]

  @@unique([id, userId])
  @@index([userId, loggedAt])
}

model MealFoodItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  mealId     Int
  foodItemId Int?
  quantity   Float
  kcal       Float
  protein    Float
  carbs      Float
  fat        Float

  meal     Meal      @relation(fields: [mealId, userId], references: [id, userId], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId, userId], references: [id, userId])

  @@index([mealId])
  @@index([foodItemId])
}

model GoalSetting {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  dailyCalories Int
  objective     String?
  startDate     DateTime @default(now())
  @@index([userId, startDate])
}