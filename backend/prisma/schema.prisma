// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

model User {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  name              String
  email             String        @unique
  passwordHash      String
  oauthProvider     String?
  avatarUrl         String?
  height            Float?
  targetWeight      Float?
  dailyCalorieGoal  Int?
  dailyProteinGoal  Int?
  dailyCarbsGoal    Int?
  dailyFatGoal      Int?
  gender            Gender?
  birthDate         DateTime?
  activityLevel     ActivityLevel?
  bodyFat           Float?
  fatFreeMass       Float?
  bodyWater         Float?
  muscleMass        Float?
  role              Role          @default(USER)
  createAt          DateTime      @default(now())
  deletedAt          DateTime?
  lastSeenAt        DateTime?
  meal              Meal[]
  foodItems         FoodItem[]
  mealFoodItems     MealFoodItem[]
  friendOf          Friend[]      @relation("FriendOf")
  userFriend        Friend[]      @relation("UserFriends")
  senderMessage     Message[]     @relation("SenderMessage")
  receiverMessage   Message[]     @relation("ReceivedMessage")
  weightLogs        WeightLog[]
  goalSettings      GoalSetting[]
  activities        Activity[]
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friend {
  id                Int     @id @default(autoincrement())
  userId            Int
  friendId          Int
  status            FriendStatus @default(PENDING)
  lastTimeConnected DateTime?
  user              User    @relation("UserFriends", fields: [userId], references: [id])
  friendUser        User    @relation("FriendOf", fields: [friendId], references: [id])
  @@index([userId])
  @@index([friendId])
  @@unique([userId, friendId])
}

model Message {
  id          Int       @id @default(autoincrement())
  receiverId  Int
  senderId    Int
  content     String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  activityId  Int?
  activity    Activity?    @relation(fields: [activityId], references: [id])
  sender      User      @relation("SenderMessage", fields: [senderId], references: [id])
  receiver    User      @relation("ReceivedMessage", fields: [receiverId], references: [id])
  
  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  weight    Float
  bodyFat   Float?
  fatFreeMass Float?
  bodyWater   Float?
  muscleMass  Float?
  loggedAt  DateTime @default(now())
  @@index([userId, loggedAt])
}

enum QuantityUnit {
  GRAM
  PIECE
  MILLILITER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model FoodItem {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  name          String
  brand         String?
  barcode       String?
  baseQuantity  Float
  baseUnit      QuantityUnit
  kcal          Float
  protein       Float
  carbs         Float
  fat           Float
  archived      Boolean        @default(false)
  mealFoodItems MealFoodItem[]

  @@unique([id, userId])
  @@index([userId])
}

model Meal {
  id           Int            @id @default(autoincrement())
  userId       Int
  user         User           @relation(fields: [userId], references: [id])
  name         String?
  typeMeal     MealType?
  loggedAt     DateTime?      @db.Date
  sourceMealId Int?
  sourceMeal   Meal?          @relation("MealTemplate", fields: [sourceMealId], references: [id], onDelete: SetNull)
  instances    Meal[]         @relation("MealTemplate")
  items        MealFoodItem[]

  @@unique([id, userId])
  @@index([userId, loggedAt])
}

model MealFoodItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  mealId     Int
  foodItemId Int?
  quantity   Float
  kcal       Float
  protein    Float
  carbs      Float
  fat        Float

  meal     Meal      @relation(fields: [mealId, userId], references: [id, userId], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId, userId], references: [id, userId])

  @@index([mealId])
  @@index([foodItemId])
}

enum ActivityType {
  MEAL_LOGGED
  WEIGHT_LOGGED
  GOAL_REACHED
  CALORIE_GOAL_CHANGED
  WEIGHT_GOAL_REACHED
  STREAK_REACHED
}

model Activity {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())
  messages  Message[]
  @@index([userId, createdAt])
}

model GoalSetting {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  dailyCalories Int
  dailyProtein  Int?
  dailyCarbs    Int?
  dailyFat      Int?
  objective     String?
  startDate     DateTime @default(now())
  @@index([userId, startDate])
}